<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>kbshare</vendor>

  <action id="org.kbshare.install-udev">
    <description>Install Logitech HID access for kbshare</description>
    <message>Authentication is required to install the kbshare Logitech HID access rule</message>
    <icon_name>input-mouse</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/kbshare</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--kbshare-install-udev-rule-helper</annotate>
  </action>

  <action id="org.kbshare.install-udev.config">
    <description>Install Logitech HID access for kbshare</description>
    <message>Authentication is required to install the kbshare Logitech HID access rule</message>
    <icon_name>input-mouse</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/kbshare-config</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--kbshare-install-udev-rule-helper</annotate>
  </action>
</policyconfig>
